# Copy to backend/.env and fill in real values. Real environment variables take precedence.

# ── App ──────────────────────────────────────────────────────
# development: seeds demo accounts, enables /docs, allows plain-http cookies.
# production (default): requires APP_SECRET_KEY, no demo accounts, no /docs.
APP_ENV=development
# At least 32 bytes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Session lifetime in minutes.
JWT_TTL_MINUTES=480

# ── Demo accounts (APP_ENV=development only) ─────────────────
# Leave empty to generate random passwords, printed once in the backend console.
SEED_ADMIN_PASSWORD=
SEED_LEARNER_PASSWORD=

# ── Rate limits ──────────────────────────────────────────────
LOGIN_RATE_LIMIT=5/minute
LLM_RATE_LIMIT=20/minute
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# ── Certificate ──────────────────────────────────────────────
# Every node done, and the average of each node's best open ended score (0 to 10) at or above this.
CERT_MIN_AVG_SCORE=7

# ── LLM ──────────────────────────────────────────────────────
# openai_compatible: OpenAI, NVIDIA NIM, vLLM, Ollama... (default)
# anthropic: Claude via the Messages API (LLM_BASE_URL defaults to https://api.anthropic.com/v1)
# offline: no network or key; deterministic keyword answers and scoring for demos
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT=30
LLM_RETRIES=3
# Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_MODEL=claude-sonnet-5-5

# ── ServiceNow knowledge (read only) ─────────────────────────
# Pulls runbooks and SOPs from ServiceNow knowledge articles. See docs/SERVICENOW_INTEGRATION.md.
# Defaults: enabled with mock mode (synthetic fixtures, no network) in development; disabled in production.
SERVICENOW_ENABLED=true
SERVICENOW_MOCK_MODE=true
# Must be https and match SERVICENOW_ALLOWED_HOSTS. Placeholder only; never commit a real instance URL.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# oauth (recommended) or basic (developer instances only). Use a dedicated, read only service account.
SERVICENOW_AUTH_MODE=oauth
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_SYNC_INTERVAL_MINUTES=60
# Hour (0 to 23, server time) of the nightly full reconciliation.
SERVICENOW_FULL_SYNC_HOUR=2
# Comma separated hostname patterns the instance URL must match.
SERVICENOW_ALLOWED_HOSTS=*.service-now.com
# Largest attachment downloaded, in MB.
SERVICENOW_MAX_DOC_MB=25
# Learners see a stale banner when the last successful sync is older than this.
SERVICENOW_STALE_HOURS=24
# Highest classification ever sent to the LLM provider (public, internal, confidential, restricted).
SERVICENOW_LLM_MAX_CLASSIFICATION=internal
# Optional: path to a mapping file outside the repo (defaults to app/integrations/servicenow/mapping.yaml).
SERVICENOW_MAPPING_PATH=
